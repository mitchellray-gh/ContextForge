# Supabase — ContextForge
# Copy this file to `.env.local` and fill in values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# Both vars are NEXT_PUBLIC_* on purpose — they are safe to expose to the
# browser. Your data is protected by Row Level Security (see supabase/migrations).

# Public project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon/publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
